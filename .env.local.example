# =========================================
# RENOTED — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# =========================================

# Resend — Envoi d'emails
# Créez un compte sur https://resend.com et obtenez votre clé API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email expéditeur (doit être vérifié dans Resend)
FROM_EMAIL=no-reply@renoted.fr

# Email destinataire des leads (Teddy)
TEDDY_EMAIL=contact@renoted.fr

# URL de production (pour les redirections et métadonnées)
NEXT_PUBLIC_SITE_URL=https://www.renoted.fr

# Google Analytics 4 (optionnel)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Anti-spam simple formulaire (optionnel)
# CONTACT_RATE_LIMIT_MAX=6
